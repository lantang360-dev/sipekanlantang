# Database - PostgreSQL (Neon / Supabase / Lokal)
# WAJIB: URL harus dimulai dengan postgresql://
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# Contoh Neon:
# DATABASE_URL="postgresql://neondb_owner:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Contoh Supabase:
# DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"

# Contoh PostgreSQL Lokal:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sipekan"
